// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth models ───────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships        Membership[]
  onboardingProgress OnboardingProgress?
  notificationPrefs  NotificationPreferences?
  apiKeysCreated     ApiKey[]
  linkedPeople       Person[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Organization models ──────────────────────────────────────────────────────

enum EntityType {
  SCHOOL
  ORGANIZATION
  EVENT
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  type        EntityType
  // Optional metadata collected during onboarding
  subtype     String?    // e.g. "primary", "secondary", "higher-institution", "other"
  sizeRange   String?    // e.g. "1-50", "50-200", etc.
  location    String?
  // Attendance methods selected during onboarding (stored as comma-separated)
  attendanceMethods String?
  // Optional logo URL from UploadThing
  logoUrl     String?
  // Human-facing public identifier (e.g. "ACME-001") — never the DB CUID
  publicId    String? @unique
  // Polar customer ID — set when the org first interacts with billing
  polarCustomerId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  memberships         Membership[]
  apiKeys             ApiKey[]
  people              Person[]
  classes             Class[]
  classMemberships    ClassMembership[]
  subjects            Subject[]
  rooms               Room[]
  timetableEntries    TimetableEntry[]
  timetableExceptions TimetableException[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]

  @@map("organization")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("membership")
}

// ─── Notification preferences ────────────────────────────────────────────────
// Per-user email/in-app notification opt-ins.
// All columns default to true (opted-in) so new users get sensible defaults.

model NotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Email notifications
  emailAttendanceSummary  Boolean @default(true)
  emailOrgInvitations     Boolean @default(true)
  emailSecurityAlerts     Boolean @default(true)
  emailAccountUpdates     Boolean @default(true)
  emailProductUpdates     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── API keys ─────────────────────────────────────────────────────────────────
// Per-organization API keys for third-party integrations.
// The raw secret is NEVER stored. Only the SHA-256 hash and a short display prefix.

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  // Short prefix shown in the UI (e.g. "rs_live_ab12")
  prefix         String
  // SHA-256 hash of the full secret – never returned to clients
  secretHash     String
  status         ApiKeyStatus @default(ACTIVE)
  // Optional expiry — null means never expires
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // The user who created this key (for audit trail)
  createdById String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([secretHash])
  @@map("api_key")
}

// ─── People ───────────────────────────────────────────────────────────────────
// A Person is an attendance identity that belongs to an organization.
// A Person is NOT automatically a Roll SYNC User — they are a separate concept.
// The linkedUserId optionally connects a Person to a User account for those
// who have been invited to Roll SYNC.

enum PersonType {
  STUDENT
  TEACHER
  STAFF
  ADMINISTRATOR
  DIRECTOR
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

model Person {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  // Optional contact info
  email          String?
  phone          String?
  // Organization-assigned identifier (e.g. student ID, staff number)
  // Used as a stable key for future attendance methods (QR, ID scan, roll call)
  orgIdentifier  String?
  personType     PersonType
  status         PersonStatus @default(ACTIVE)
  // Optional link to a Roll SYNC User — set only when the Person has been
  // explicitly invited and has an account. NEVER auto-created on Person add.
  linkedUserId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedUser   User?        @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)

  // Class memberships for students
  classMemberships     ClassMembership[]
  // Timetable entries where this person is the teacher
  timetableAsTeacher   TimetableEntry[]         @relation("TimetableTeacher")
  // Timetable exceptions where this person is a substitute
  timetableAsSubstitute TimetableException[]    @relation("TimetableSubstitute")
  // Attendance sessions where this person is the teacher
  attendanceAsTeacher  AttendanceSession[]      @relation("AttendanceTeacher")
  // Attendance records (as a student/attendee)
  attendanceRecords    AttendanceRecord[]

  // An org identifier must be unique within the organization (when set)
  @@unique([organizationId, orgIdentifier])
  @@index([organizationId])
  @@index([linkedUserId])
  @@map("person")
}

// ─── School infrastructure ────────────────────────────────────────────────────

// A Class is a named cohort/group within an organization.
// e.g. "SS2A", "Grade 10 Blue", "Year 11", "Computer Science Cohort"
// The class has a stable cuid that will anchor future QR identity.

enum ClassStatus {
  ACTIVE
  INACTIVE
}

model Class {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  // Short code shown in timetable cells (optional)
  code           String?
  description    String?
  status         ClassStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships        ClassMembership[]
  timetableEntries   TimetableEntry[]
  attendanceSessions AttendanceSession[]

  // Names must be unique within an org
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("class")
}

// ClassMembership: a Person (usually a Student) belonging to a Class.
// Preserves history: a student may move classes; old records remain with
// an endDate set so past attendance remains historically correct.

model ClassMembership {
  id             String    @id @default(cuid())
  organizationId String
  classId        String
  personId       String
  // Effective date range — endDate null means currently enrolled
  startDate      DateTime  @default(now())
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([classId])
  @@index([personId])
  @@map("class_membership")
}

// Subject: a reusable teaching subject within an organization.
// e.g. "Mathematics", "Physics", "English Language"

model Subject {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // Optional short code (e.g. "MATH", "PHY")
  code           String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
  attendanceSessions AttendanceSession[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("subject")
}

// Room: a lightweight venue/location within an organization.
// e.g. "Room 12", "Science Lab", "Computer Lab", "Hall", "Field", "Online"

model Room {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // Optional short code displayed in timetable cells
  code           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("room")
}

// TimetableEntry: describes a RECURRING class session.
// Source of truth: Teacher + Class + Subject + Time + Days.
// Period labels (e.g. "Period 1") are optional metadata.
//
// Days of week stored as comma-separated integers (0=Sun, 1=Mon ... 6=Sat)
// to keep the schema simple and avoid array types.

enum TimetableStatus {
  ACTIVE
  INACTIVE
}

model TimetableEntry {
  id             String          @id @default(cuid())
  organizationId String
  // The teacher (Person with personType=TEACHER) responsible for this slot
  teacherPersonId String
  classId        String
  subjectId      String
  roomId         String?
  // Time as "HH:MM" 24-hour strings for simplicity and portability
  startTime      String          // e.g. "08:00"
  endTime        String          // e.g. "08:40"
  // Comma-separated ISO day numbers: "1,2,3,4,5" = Mon-Fri
  daysOfWeek     String
  // Effective date range for this recurring schedule
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  // Optional period label metadata
  periodLabel    String?
  status         TimetableStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacherPerson Person               @relation("TimetableTeacher", fields: [teacherPersonId], references: [id], onDelete: Restrict)
  class         Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject       Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  room          Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  exceptions    TimetableException[]
  attendanceSessions AttendanceSession[]

  @@index([organizationId])
  @@index([teacherPersonId])
  @@index([classId])
  @@index([subjectId])
  @@map("timetable_entry")
}

// TimetableException: overrides a specific occurrence of a TimetableEntry.
// Used for: cancellation, rescheduling, substitute teacher, room change.

enum ExceptionType {
  CANCELLED    // Class is cancelled on this date
  RESCHEDULED  // Class moved to a different time on the same or another date
  SUBSTITUTED  // Different teacher covers the class
  ROOM_CHANGE  // Different room used
  OTHER        // General override
}

model TimetableException {
  id               String        @id @default(cuid())
  organizationId   String
  timetableEntryId String
  // The specific date this exception applies to (the original scheduled date)
  exceptionDate    DateTime
  exceptionType    ExceptionType
  // If rescheduled: override time / date
  newDate          DateTime?
  newStartTime     String?
  newEndTime       String?
  // If substituted: the substitute teacher Person
  substitutePersonId String?
  // If room change: the new room
  newRoomId        String?
  // Free-text note for context
  note             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timetableEntry  TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  substitutePerson Person?       @relation("TimetableSubstitute", fields: [substitutePersonId], references: [id], onDelete: SetNull)

  @@unique([timetableEntryId, exceptionDate])
  @@index([organizationId])
  @@index([timetableEntryId])
  @@map("timetable_exception")
}

// ─── Attendance ───────────────────────────────────────────────────────────────
//
// AttendanceSession: records that a specific class actually happened on a day.
// Created by the teacher (or an admin) when they "sign in" to a class.
// Links back to the TimetableEntry so we can compare scheduled vs actual.
//
// One session per (timetableEntryId, date). Prevents duplicates.

enum ArrivalStatus {
  EARLY       // teacher arrived before scheduled start
  ON_TIME     // within the grace window
  LATE        // after scheduled start + grace
  VERY_LATE   // significantly late
}

enum SessionStatus {
  ACTIVE      // in progress
  COMPLETED   // roll call saved/submitted
  CANCELLED   // session was cancelled after sign-in
}

model AttendanceSession {
  id               String        @id @default(cuid())
  organizationId   String
  timetableEntryId String
  // The teacher Person who signed in
  teacherPersonId  String
  classId          String
  subjectId        String
  // The calendar date this session covers (date only, no time component)
  sessionDate      DateTime
  // Actual check-in timestamp (server-set, never trusted from client)
  checkinAt        DateTime      @default(now())
  arrivalStatus    ArrivalStatus
  status           SessionStatus @default(ACTIVE)
  // Optional override room (if a room change occurred)
  roomId           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timetableEntry TimetableEntry       @relation(fields: [timetableEntryId], references: [id], onDelete: Restrict)
  teacherPerson  Person               @relation("AttendanceTeacher", fields: [teacherPersonId], references: [id], onDelete: Restrict)
  class          Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  records        AttendanceRecord[]

  // One session per timetable entry per calendar date
  @@unique([timetableEntryId, sessionDate])
  @@index([organizationId])
  @@index([teacherPersonId])
  @@index([classId])
  @@map("attendance_session")
}

// AttendanceRecord: one record per student per session.
// Created/updated during roll call.

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE      // student arrived late
  EXCUSED   // absent with an accepted excuse
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  organizationId      String
  attendanceSessionId String
  // The student Person being tracked
  personId            String
  status              AttendanceStatus
  // Optional note (e.g. reason for absence/late)
  note                String?
  // Server-set timestamp of when this record was last saved
  recordedAt          DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  person            Person            @relation(fields: [personId], references: [id], onDelete: Cascade)

  // One record per student per session
  @@unique([attendanceSessionId, personId])
  @@index([organizationId])
  @@index([attendanceSessionId])
  @@index([personId])
  @@map("attendance_record")
}

// ─── Onboarding progress ──────────────────────────────────────────────────────

model OnboardingProgress {
  id          String   @id @default(cuid())
  userId      String   @unique
  // Which step the user is on (1-3; 4 = done)
  currentStep Int      @default(1)
  // JSON snapshot of data entered so far
  data        String   @default("{}")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}
